# ============================================================
# Panel de marca · variables de entorno
# Copia como .env.local. En Vercel van en Settings → Environment Variables.
# ============================================================

# Modo de la app.
#   local → una persona en su computadora: sin login, base en ./data/panel,
#           el panel se actualiza solo mientras está abierto. Solo abre en 127.0.0.1.
#   cloud → Vercel + Neon + login con Google (necesita todo lo de abajo).
# En Vercel siempre es cloud, diga lo que diga esta variable.
APP_MODE=local

# Base de datos. Local: vacío (usa ./data/panel). Nube: Neon (termina en ?sslmode=require).
DATABASE_URL=

# ---------- Solo modo nube ----------

# Sesiones. Generar con: openssl rand -base64 32
AUTH_SECRET=

# Login con Google (console.cloud.google.com → APIs y servicios → Credenciales → ID de cliente OAuth, tipo «Aplicación web»)
# URI de redirección autorizada: https://TU-DOMINIO/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Correos con acceso, separados por coma
ALLOWED_EMAILS=

# Vercel Cron lo manda solo si se llama exactamente así. Generar con: openssl rand -hex 24
CRON_SECRET=

# Solo desarrollo
# AUTH_DEV_BYPASS=1        entra sin login en `next dev` (en producción no tiene efecto)
# ENABLE_MOCK_SOURCE=1     habilita la fuente de datos de prueba
